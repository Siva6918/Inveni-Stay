# ==============================================================================
# INVENI STAY — Environment Variables Reference
# WeMakeDevs × AWS — Bharat Builds Tour 2026
# ==============================================================================
# STEP 1: Copy this file:  cp .env.example .env
# STEP 2: Fill in values after running: sam deploy --guided
# STEP 3: NEVER commit .env to git (it is in .gitignore)
# ==============================================================================

# ── CORE AWS SETTINGS ──────────────────────────────────────────────────────────
VITE_AWS_REGION=ap-south-1

# ── AMAZON API GATEWAY ─────────────────────────────────────────────────────────
# Get from: sam deploy output "ApiEndpoint"
# Example:  https://abc123xyz.execute-api.ap-south-1.amazonaws.com
VITE_API_BASE_URL=

# ── AMAZON COGNITO ─────────────────────────────────────────────────────────────
# Get from: sam deploy output "UserPoolId" and "UserPoolClientId"
# Example Pool ID:    ap-south-1_AbCdEfGhI
# Example Client ID:  1abc2defghijklmnopqrstuvwx
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# ── DATA MODE ──────────────────────────────────────────────────────────────────
# false = Controlled Demo Mode (no AWS required — works offline)
# true  = Live AWS backend (requires all above values filled in)
VITE_USE_CLOUD_BACKEND=false

# ── GOOGLE MAPS (for Street View + Satellite embed) ────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Enable APIs: Maps Embed API, Maps JavaScript API, Street View Static API
# Restrict to: HTTP referrers (your domain + localhost:5173)
VITE_GOOGLE_MAPS_API_KEY=

# ── AMAZON OPENSEARCH SERVERLESS ───────────────────────────────────────────────
# Get from: sam deploy output "OpenSearchEndpoint"
# Example: https://abc123.ap-south-1.aoss.amazonaws.com
VITE_OPENSEARCH_ENDPOINT=

# ── AMAZON CLOUDFRONT (Media CDN) ──────────────────────────────────────────────
# Get from: sam deploy output "CloudFrontDomain"
# Example: d1234abcd.cloudfront.net
VITE_CLOUDFRONT_DOMAIN=

# ── AWS APP RUNNER (AI + PDF Microservice) ─────────────────────────────────────
# Get from: sam deploy output "AppRunnerServiceUrl"
# Example: https://abc123.ap-south-1.awsapprunner.com
VITE_APP_RUNNER_URL=

# ── AMAZON S3 MEDIA BUCKET ─────────────────────────────────────────────────────
# Get from: sam deploy output "MediaBucketName"
# Example: inveni-stay-media-123456789012-ap-south-1
VITE_MEDIA_BUCKET=

# ── AMAZON SNS TOPIC ───────────────────────────────────────────────────────────
# Get from: sam deploy output "NotificationTopicArn"
# Example: arn:aws:sns:ap-south-1:123456789012:InveniStayNotifications
VITE_SNS_TOPIC_ARN=

# ── AURORA SERVERLESS v2 (Analytics — backend only, not exposed to frontend) ───
# These are used by the AnalyticsFunction Lambda, set automatically by SAM.
# You only need these if running Lambda locally via sam local invoke.
# RDS_CLUSTER_ARN=arn:aws:rds:ap-south-1:123456789012:cluster:inveni-stay-analytics
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:InveniStayDBCredentials
